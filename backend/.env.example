# =============================================================================
# Wayhall Municipal Knowledge Assistant — Environment Configuration
# Duplicate this file to .env and fill in your API credentials.
# =============================================================================

# --- Supabase Database ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-anon-or-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- Google Gemini AI ---
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key
GEMINI_EMBED_MODEL=models/gemini-embedding-001
GEMINI_LLM_MODEL=models/gemini-3.5-flash-lite
EMBEDDING_DIMENSIONS=768

# --- Ingestion & Chunking Parameters ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# --- RAG Pipeline Tuning ---
TOP_K_PER_DOC=5
MAX_HISTORY_TURNS=8
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=2.0

# --- CORS Allowed Origins ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
